	(text "R_FB divider: V_OUT=3.3V, V_FB=0.765V (datasheet sec. 8.3.5.3)\nR_FB1 = R_FB2 * (V_OUT/0.765 - 1)\nR_FB2=100k, R_FB1=100k*(3.3/0.765-1) = 331.4k ~= 332k (E96)\nR_FB2=100k, R_FB1=332k -> V_OUT = 0.765*(1+3.32) = 3.30V"
		(exclude_from_sim no)
		(at 25.4 44.196 0)
		(effects
			(font
				(size 0.508 0.508)
			)
			(justify left)
		)
		(uuid "8b64a04a-476e-49e6-962a-728d58ae96f2")
	)
	(text "C_Bulk: \nI_peak=30A, f_PWM=20kHz, V_max=36V\nd_t = 1/f_PWM = 50µs (worst case transient duration)\nd_V_target = 1% * 36V = 0.36V\nC = I*d_t/d_V = 30*50us/0.36 = 4167uF minimum\nselected 4700uF"
		(exclude_from_sim no)
		(at 20.066 115.57 0)
		(effects
			(font
				(size 0.508 0.508)
			)
			(justify left)
		)
		(uuid "91626262-a660-4b04-ad24-018b3b88d783")
	)
	(text "R_SENSE: \nI_peak=30A, CSA gain=40, DVDD=3.3V\nV_SENSE_MAX = 3.3/40 = 82.5mV\nR_ideal = 82.5mV/30A = 2.75mOhm\nR_SENSE <= 2.75mOhm\nR_SENSE = 2mOhm"
		(exclude_from_sim no)
		(at 19.558 145.288 0)
