	(text "SOA, SOB, SOC: 3 ADC pins\nINHA, INHB, INHC, INLA, INLB, INLC: 6 PWM-capable timer pins\nnSCS, SCLK, SDI, SDO: SPI peripheral pins\nnFAULT: interrupt-capable GPIO pin\nENABLE: any GPIO pin\nCAL: anyGPIO pin or LOW"
		(exclude_from_sim no)
		(at 24.638 88.392 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "4f0c66a9-871c-4c1f-a405-c0339ea2f3cc")
	)
	(text "VBUS_SENSE divider: \nV_max = 36V, V_ADC=3.3V\nR_top/R_bottom = (36-3.3)/3.3 = 9.909\nR_bottom=10k, R_top=10k*9.909 = 99.09k ~= 100k\nR_top=100k, R_bottom=10k\n\n"
		(exclude_from_sim no)
		(at 113.03 90.17 0)
		(effects
			(font
				(size 0.508 0.508)
			)
			(justify left)
		)
		(uuid "54653b5d-92ca-4467-acf2-72762347d942")
	)
	(text ""
		(exclude_from_sim no)
